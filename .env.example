# ---- Database (Supabase / Neon pooled Postgres) ----------------------------------------
DATABASE_URL=
# Optional: direct (non-pooled) URL used by the migration runner when the pooler
# cannot run DDL. Falls back to DATABASE_URL.
DATABASE_URL_DIRECT=

# ---- Telegram ingestion (READ-ONLY; use a dedicated NON-personal account, R7) -----------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_CHANNELS=

# ---- Jev / System One (R2) -------------------------------------------------------------
# Official endpoint per TypeSafe public docs. Any other host is an UNVERIFIED third party.
JEV_BASE_URL=https://api.typesafe.ai
JEV_API_KEY=
# Comma-separated host allowlist. The client REFUSES to send anything to a host that is
# not listed here. Add hosts only after verifying the operator and its retention policy.
JEV_ALLOWED_HOSTS=api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_S=20
JEV_MAX_CONCURRENCY=3

# ---- OpenRouter (free models: translation / strict-JSON extraction only, R1a) ----------
OPENROUTER_API_KEY=
# Ordered fallback chain, first model that yields valid JSON wins.
EXTRACTION_MODELS=
# ONE strong model, used ONLY for the final narrative + hypothesis proposal (R1d).
EXPLAINER_MODEL=

# ---- Price sources ---------------------------------------------------------------------
NOBITEX_BASE=https://apiv2.nobitex.ir
XAUUSD_PROVIDER=yfinance
TGJU_ENABLED=true
TSETMC_ENABLED=true
# Optional TSETMC gold-fund symbols, comma separated (trader selects in UI).
TSETMC_SYMBOLS=
# Nobitex public rate limit is 60 req/min; we throttle to half of it.
NOBITEX_MAX_REQ_PER_MIN=30

# ---- Worker / UI handshake -------------------------------------------------------------
WORKER_WEBHOOK_SECRET=
WORKER_BASE_URL=http://127.0.0.1:8787
WORKER_PORT=8787
APP_TIMEZONE=Asia/Tehran

# ---- Research window -------------------------------------------------------------------
# First 4 months (by trading day) = discovery, last 2 months = untouched out-of-sample.
# START_DATE is the first replayed decision day. HISTORY_START_DATE is START_DATE - 6 months
# and is the earliest data we try to ingest.
START_DATE=2026-04-01
HISTORY_MONTHS=6
DISCOVERY_MONTHS=4
CHECKPOINTS_LOCAL=08:00,12:00,16:00
TRADING_WEEKDAYS=5,6,0,1,2
FLAT_BAND_BPS=15

# ---- Risk / costs (deterministic code only, R6/R5) -------------------------------------
SPREAD_BPS_GOLD=30
SLIPPAGE_BPS_GOLD=15
SPREAD_BPS_COIN=50
SLIPPAGE_BPS_COIN=25
MAX_SPREAD_BPS_TRADEABLE=60
JEV_MIN_CONFIDENCE=0.60
POSITION_SIZE_G=1000
STOP_LOSS_BPS=100
DAILY_LOSS_CAP_BPS=200
FLAT_AT_LOCAL=22:00
OPEN_AT_LOCAL=08:00

# ---- Hard safety -----------------------------------------------------------------------
# PAPER_ONLY must stay true in Phase 1. Flipping it is a code change review item; there is
# no order-placing code path anywhere in this repository.
PAPER_ONLY=true

# ---- Local/demo (never used for research conclusions) -----------------------------------
# GM_DEMO_MODE=1 lets scripts run against synthetic fixtures with no credentials.
GM_DEMO_MODE=0
GM_DEMO_DATABASE_URL=
